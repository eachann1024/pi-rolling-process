{
  "name": "pi-mini-lens",
  "version": "1.3.0",
  "description": "A compact Pi footer with live usage metrics, theme-aware settings previews, and configurable progress bars.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node test/footer-status-self-check.mjs && node test/settings-interaction.mjs"
  },
  "license": "MIT",
  "author": "eachann1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eachann1024/pi-mini-lens.git"
  },
  "bugs": {
    "url": "https://github.com/eachann1024/pi-mini-lens/issues"
  },
  "homepage": "https://github.com/eachann1024/pi-mini-lens#readme",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "footer",
    "tui"
  ],
  "pi": {
    "video": "https://raw.githubusercontent.com/eachann1024/pi-mini-lens/main/assets/mini-lens-settings.mp4",
    "extensions": [
      "./extensions/footer-status.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": "*"
