{
  "name": "pi-minimal-mode",
  "version": "1.3.0",
  "description": "Inline process summary for Pi: one collapsible disclosure of the last N tool/thought steps (default 6, /process to configure), ctrl+o to expand or collapse, /process-native on|off to hide or show native tool cards, and hides Working/Thinking chrome.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node test/self-check.mjs"
  },
  "license": "MIT",
  "author": "eachann1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eachann1024/pi-rolling-process.git"
  },
  "bugs": {
    "url": "https://github.com/eachann1024/pi-rolling-process/issues"
  },
  "homepage": "https://github.com/eachann1024/pi-rolling-process#readme",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "transcript",
    "tui"
  ],
  "pi": {
    "extensions": ["./extensions/rolling-process.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
