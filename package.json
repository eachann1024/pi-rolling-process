    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
